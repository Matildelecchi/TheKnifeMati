<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="20" stylesheets="@../../../data/stile.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.theknife.client.UserProfileController">
  <padding>
    <Insets bottom="20" left="20" right="20" top="20"/>
  </padding>
  <!-- Header con info utente -->
  <VBox styleClass="profile-header">
    <HBox alignment="CENTER_LEFT" spacing="10">
      <VBox HBox.hgrow="ALWAYS">
        <Label fx:id="nomeLabel" styleClass="profile-name"/>
        <Label fx:id="ruoloLabel" styleClass="profile-role"/>
      </VBox>
      <Button fx:id="tornaalMenuButton" styleClass="primary-button" text="Torna al Menu"/>
      <Button fx:id="dashboardButton" styleClass="primary-button" text="Dashboard Ristoratore"/>
      <Button fx:id="logoutButton" styleClass="danger-button" text="Logout"/>
    </HBox>
  </VBox>
  <!-- Sezione Recensioni -->
  <VBox spacing="10">
    <Label styleClass="section-title" text="Le Mie Recensioni"/>
    <TableView fx:id="recensioniTable" VBox.vgrow="ALWAYS">
      <columns>
        <TableColumn fx:id="ristoranteColumn" prefWidth="200" text="Ristorante"/>
        <TableColumn fx:id="titoloColumn" prefWidth="100" text="Titolo"/>
        <TableColumn fx:id="stelleColumn" prefWidth="60" text="Stelle"/>
        <TableColumn fx:id="testoColumn" prefWidth="250" text="Testo"/>
        <TableColumn fx:id="dataColumn" prefWidth="100" text="Data"/>
      </columns>
    </TableView>
  </VBox>
  <!-- Sezione Preferiti (visibile solo per clienti) -->
  <VBox fx:id="preferitiBox" spacing="10">
    <Label styleClass="section-title" text="I Miei Preferiti"/>
  </VBox>
  <TableView fx:id="preferitiList" prefHeight="324.0" prefWidth="662.0">
    <columns>
      <TableColumn fx:id="ristoranteColumn1" prefWidth="161.5999755859375" text="Ristorante"/>
      <TableColumn fx:id="stelleColumn1" prefWidth="70.4000244140625" text="Stelle"/>
      <TableColumn fx:id="cittaColumn" minWidth="0.0" prefWidth="131.20001220703125" text="Città"/>
      <TableColumn fx:id="statoColumn" prefWidth="121.5999755859375" text="Stato"/>
      <TableColumn fx:id="cucinaColumn" minWidth="4.79998779296875" prefWidth="182.4000244140625" text="Cucina"/>
    </columns>
  </TableView>
</VBox>
